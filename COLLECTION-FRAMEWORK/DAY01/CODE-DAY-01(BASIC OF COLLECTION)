import java.util.*;

class Main {
    public static void main(String[] args) {
        ArrayList<String> list = new ArrayList<>();
        list.add("bhupesh");
        System.out.println(list.add("bhupesh"));
        ArrayList<String> list2 = new ArrayList<>();
        list2.add("2");
        // if we want to add all elements

        list2.addAll(list);
        System.out.println(list2.addAll(list));

        //print arraylist
        System.out.println(list);
        System.out.println(list2);

        // removing the element
        list2.remove("bhupesh");
        System.out.println(list2.remove("bhupesh"));
        // if elements is not present in it then it will return false
        System.out.println(list2.remove("bkk"));

        // removing all elemnts from the list
        System.out.println(list.removeAll(list));
        System.out.println(list);

        // to see the collection is empty or not
        System.out.println(list.isEmpty());

        // to return the size for the list -> reference_name.size()
        if (list.isEmpty()) {
            System.out.println(list2.size());
        }

        Collection<Integer> l1 = new ArrayList<>();
        l1.add(1);
        l1.add(2);
        System.out.println(l1);

        // to make all element delete we also use clear
        l1.clear();
        System.out.println(l1);

        // to see whwther the list contains an element -> .contains(object)
        System.out.println(l1.contains(1));

        // another method equals(object}
        List<String> a1=new ArrayList<>();
        a1.add("bhupesh");
        a1.add("kumar");
        a1.add("karir");
        Set<String>s1=new HashSet<>();
        s1.add("karir");
        s1.add("kumar");
        s1.add("bhupesh");

        System.out.println(a1.equals(s1));
        System.out.println(s1.equals(a1));

        // remove all
        a1.removeAll(s1);
        System.out.println(a1);

        // retain all
        s1.retainAll(a1);
        System.out.println(s1);

        // concept of iterator
        List<String> b1=new ArrayList<>();
        b1.add("1");
        b1.add("2");
        b1.add("bhupesh");
        // as iterator is an interface
        Iterator<String>itr= b1.iterator();
        while(itr.hasNext()){
            System.out.println(itr.next());
        }

    }
}

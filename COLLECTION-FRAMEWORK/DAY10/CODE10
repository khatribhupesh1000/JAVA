class Customer {
    private String CustName;
    private int CustId;

    Customer(String CustName, int CustId) {
        this.CustName = CustName;
        this.CustId = CustId;

    }

    public String getCustName() {
        return CustName;
    }

    public int getCustId() {
        return CustId;
    }

    @Override
    public String toString() {
        return CustName + " " + CustId;
    }

    @Override
    public int hashCode() {
        return Objects.hash(CustName, CustId);
    }

    @Override
    public boolean equals(Object obj) {
        if(this==obj) return true;
        if(!(obj instanceof Customer)) return false;
        Customer that = (Customer) obj; // type casting Object to Customer
        return this.CustName.equals(that.CustName) && this.CustId == that.CustId;
    }
}

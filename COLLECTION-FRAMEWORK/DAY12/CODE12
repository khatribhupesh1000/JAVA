class Book {
    private String author;
    private String title;
    private int bookId;

    Book(String author, String title, int bookId) {
        this.author = author;
        this.title = title;
        this.bookId = bookId;
    }

    public String getAuthor() {
        return author;
    }

    public String getTitle() {
        return title;
    }

    public int getBookId() {
        return bookId;
    }
    @Override
    public String toString(){
        return author+" "+ title+ " "+bookId;
    }
}

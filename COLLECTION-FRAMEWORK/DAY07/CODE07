// comparing custom objects by using  comparator

class Student {
    private String name;
    private double marks;
    private int rollNumber;
    Student(String name,double marks,int rollNumber){
        this.name=name;
        this.marks=marks;
        this.rollNumber=rollNumber;
    }
// now you have to declare the comparator in the main class


    @Override
    public String toString(){
        return rollNumber+" "+name+" "+marks;
    }
    public int getRollNumber() {
        return rollNumber;
    }
    public String getName() {
        return name;
    }
}


import java.util.ArrayList;
import java.util.Collection;
import java.util.Collections;
import java.util.List;

public class DAY03 {
    public static void main(String[] args) {
        // declaration of arraylist without generics
        // this is the class of object type
        ArrayList list=new ArrayList();
        list.add(1);// auto-boxing
        list.add("2");
        System.out.println(list);
        // but to retrieve the data we have to type cast the data
        // because the elements are of the object type
        //int a=list.get(0); -> show an error so type caste it to the particular primitive type
        int a=(int)list.get(0);//un-boxing
        System.out.println(a);
        String b=(String)list.get(1);
        System.out.println(b);
        // no need to type caste
        System.out.println(list.get(0));


        // with generics
        List<String> l1=new ArrayList<>();
        l1.add("b");
        l1.add("a");
        System.out.println(l1);

        // initializing the size of the arraylist initially
        List<String>list1=new ArrayList<>(2);
        list1.add(null);
        list1.add(null);
        System.out.println(list1);

        System.out.println(list1.addAll(list));
        System.out.println(list1);
        // note -> there is the concept of binding -> static and dynamic binding

        Collection<String>c1=new ArrayList<>();
        c1.add("1");
        //c1.add(1,"2");-> this will give compile time error as in the add(index,object) will reject
                // at time of compile time only so not go for run time which means
                // at static time only it will reject and when jvm has to decide out of the
                // given methods which is surpassed by the static binding then it will do by jvm at
                // run time that is known as dynamic binding

        // let's see the concept of mutable and immutable
        ArrayList<Integer>list3=new ArrayList<>(20);
        ArrayList<Integer>list4=new ArrayList<>(List.of(1,2,3,4,5));
        list4.add(234);
        list4.add(1);
        list4.add(1,34);// -> not give the error as List.of() is immutable but arraylist is mutable
        System.out.println(list4);

        // to increase the List.of(having max 10 objects) then
        // use List.ensureCapacity(number of objects)
        list4.ensureCapacity(20);


    }
}


import java.util.Iterator;
import java.util.LinkedHashSet;

public class DAY11 {
    public static void main(String[] args) {
        LinkedHashSet<Integer>lh1=new LinkedHashSet<>();
        lh1.add(2);
        lh1.add(3);
        lh1.add(0);
        lh1.add(1);
        lh1.forEach(s-> System.out.println(s));// lembda function
        System.out.println();
        lh1.forEach(System.out::println);// method reference
        Iterator<Integer>itr= lh1.iterator();// iterator
        while (itr.hasNext()){
            System.out.print(itr.next());
        }

    }
}


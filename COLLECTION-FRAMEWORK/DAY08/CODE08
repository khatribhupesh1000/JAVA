
import java.util.*;

public class DAY08 {
    public static void main(String[] args) {
        // queue is the interface so refrence variable can be made of it but the creation of the object
        // should be of the  LinkedList class
        Queue<Integer>q1=new LinkedList<>(List.of(1,2,3,4,5));
        q1.add(6);
        System.out.println(q1);// in this we will get
        q1.offer(7);
        System.out.println(q1.offer(7));
        q1.clear();
        System.out.println(q1);
        //q1.remove(); -> as the queue is empty it will throw an exception
        // Exception in thread "main" java.util.NoSuchElementException
        //	at java.base/java.util.LinkedList.removeFirst(LinkedList.java:281)
        //	at java.base/java.util.LinkedList.remove(LinkedList.java:696)
        //	at DAY08.main(DAY08.java:16)
        q1.poll();
        System.out.println(q1.poll());
        q1.peek();
        System.out.println(q1.peek());

        // iterator in queue
        Queue<Integer>q2=new LinkedList<>(List.of(1,2,3,4,5));
        Iterator<Integer>itr1= ((LinkedList<Integer>) q2).descendingIterator();
        while (itr1.hasNext()){
            System.out.println(itr1.next());

        }

        // implementation of the deque through linkedlist
        Deque<Integer>dq1=new LinkedList<>(List.of(1,2,3,4,5));
        dq1.addFirst(0);
        dq1.addLast(6);
        dq1.offerFirst(-1);
        dq1.offerLast(7);
        System.out.println(dq1);
        dq1.remove();// it will remove from the first
        System.out.println(dq1);
        dq1.pollLast();
        System.out.println(dq1);
        dq1.pollFirst();
        System.out.println(dq1);
        System.out.println(dq1.peek());
        System.out.println(dq1.peekLast());
        System.out.println(dq1.peekFirst());
        System.out.println(dq1.getClass());
        System.out.println(dq1.getFirst());
        System.out.println(dq1.getLast());

        // implementing deque through ArrayDeque class
        Deque<Integer>dq2=new ArrayDeque<>(List.of(1,2,3,4,5));
        dq2.add(12);
        System.out.println(dq2);
        dq2.addLast(13);
        dq2.addFirst(0);
        System.out.println(dq2);
    }
}

//
//    }-> this will not use directly for -each loop as this class is not implemented the iterable interface
        for(String s:bk.getData()){// in this we can access through the class methods
            System.out.println(s);
        }
//    so the class must implement the iterable interface
        jennyLecture jl=new jennyLecture();// in this as jennyCollection implements the iterable interface so we explicitly use for-each loop
        for(String s:jl){
            System.out.println(s);
        }

// -> in this we can also use the lembda expression and further it can be replaced by the method refrences
        List<Integer>l1=new ArrayList<>(List.of(1,2,3,4,5));
        l1.forEach(n-> System.out.println(n));// in this action is performed
        // by method refrences
        l1.forEach(System.out::println);
        // println-> it is a method in the string class
        // System.out -> it is instance of class/ return object

//-> as we are using now multiply in each of the elements of list -> how we do that?
        List<Integer>l2=new ArrayList<>(List.of(1,2,3,4,5));
        l2.forEach(DAY04::add);
        // DAY04::add is a method reference

        l2.forEach(a->DAY04.add(a));

        for(Integer a:l2){
            DAY04.add(a);
        }
// -> the above three statements are all equivalent

        ArrayList<String>a5=new ArrayList<>(List.of("b","k","k"));
        Iterator<String>itr2=a5.iterator();
        while(itr2.hasNext()){
            String str=itr2.next();
            if(str.equals("k")){
                itr2.remove();
                // itr2.remove();-> it will give you exception IllegalStateException

                // after the operation if we want to perform the operation of remaining elements
                    // then forEachRemaining() method is used
                itr2.forEachRemaining(DAY04::add);
                // the output is k10
            }
        }
    }

    private static void add(String s) {
        System.out.println(s+10);
    }

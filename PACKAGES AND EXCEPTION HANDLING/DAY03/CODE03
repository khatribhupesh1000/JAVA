    // method of flow of exception
    // 1-> method2() -> where the exception occurs and it does not have catch capabilities
    // 2-> method1()
    // 3-> main()
    // 4-> jvm catches it and use the printStackTree() method -> program crash

    // lets make it checked exception

    public static void main(String[] args) {
        try {
            method1();
        } catch (Exception e) {
            System.out.println("b can not be 0");
        }
    }
    static void method1() throws Exception{
        method2();
    }
    static void method2() throws Exception{
        int a=5,b=0;
        if(b==0){
            throw new Exception("b can not be 0");// it become checked exception because we use
                                                    // Exception which has checked and unchecked 
                                                    // exception
        }
        System.out.println(a/b);
    }

